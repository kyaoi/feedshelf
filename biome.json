{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig.json",
      "tsconfig.web.json",
      "data/**",
      "src/**",
      "scripts/**",
      "tests/**",
      "!scripts/**/*.js",
      "!public/**",
      "!.diffship/**"
    ]
  },
  "linter": {
    "enabled": true,
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig.json",
      "tsconfig.web.json",
      "data/**",
      "src/**",
      "scripts/**",
      "tests/**",
      "!scripts/**/*.js",
      "!public/**",
      "!.diffship/**"
    ],
    "rules": {
      "recommended": true,
      "complexity": {
        "useArrowFunction": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "security": {
        "noGlobalEval": "off"
      }
    }
  },
  "javascript": {
    "assist": {
      "enabled": false
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
